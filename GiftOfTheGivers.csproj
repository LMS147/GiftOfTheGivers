<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <HelperPackageVersion Condition="'$(HelperPackageVersion)' == ''">1.0.1</HelperPackageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-GiftOfTheGivers-e01789bb-c31b-497f-bd5e-11897265a2c3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="9.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="GiftOfTheGivers.Helpers\GiftOfTheGivers.Helpers.csproj" Condition="'$(UseHelperPackage)' != 'true'" />
    <PackageReference Include="GiftOfTheGivers.Helpers" Version="$(HelperPackageVersion)" Condition="'$(UseHelperPackage)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="GiftOfTheGivers.Tests\**" />
    <Content Remove="GiftOfTheGivers.Tests\**" />
    <Compile Remove="GiftOfTheGivers.Functions\**" />
    <Compile Remove="GiftOfTheGivers.Helpers\**" />
    <EmbeddedResource Remove="GiftOfTheGivers.Functions\**" />
    <EmbeddedResource Remove="GiftOfTheGivers.Helpers\**" />
    <None Remove="GiftOfTheGivers.Functions\**" />
    <None Remove="GiftOfTheGivers.Helpers\**" />
  </ItemGroup>

</Project>


        <dependency id="Microsoft.EntityFrameworkCore.SqlServer" version="9.0.20" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DependencyInjection" version="9.0.20" exclude="Build,Analyzers" />
      </group>
    </dependencies>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- =================================================================== -->
    <!-- SECTION D: NuGet Packaging Properties for Azure Artifacts Feed      -->
    <!-- =================================================================== -->
    <PackageId>GiftOfTheGivers.Helpers</PackageId>
    <Version>1.0.0</Version>
    <Authors>Gift of the Givers Foundation</Authors>
    <Company>Gift of the Givers</Company>
    <Product>Gift of the Givers Shared Utility Library</Product>
    <Title>Gift of the Givers Helper Library</Title>
    <Description>Custom helper library for Gift of the Givers applications. Provides utilities for Section 18A tax certificate number formatting, SARS tax deduction relief calculations, South African Rand (ZAR) currency formatting, and donation metrics aggregation.</Description>
    <PackageTags>GiftOfTheGivers;Donations;Section18A;TaxCertificate;AzureArtifacts;Helpers</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity" Version="2.3.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.20" />
  </ItemGroup>

</Project>

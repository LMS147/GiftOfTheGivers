@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="state-page">
    <div class="state-icon"><i class="bi bi-exclamation-triangle"></i></div>
    <h1>Something went wrong</h1>
    <p class="mb-1">
        An unexpected error occurred while processing your request.
        Please try again — or head back to the home page.
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mb-4">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
    else
    {
        <p class="mb-4"></p>
    }
    <a class="btn btn-gotg px-4" asp-area="" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house me-1"></i> Back to home
    </a>
    <a class="btn btn-outline-secondary px-4" asp-area="" asp-controller="Home" asp-action="Contact">Contact us</a>
</div>

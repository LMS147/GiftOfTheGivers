@{
    var active = ViewData["NavActive"]?.ToString() ?? "";
    var isStaff = User.IsInRole("Staff");
    var isVolunteer = User.IsInRole("Volunteer");
    var roleName = isStaff ? "Staff" : isVolunteer ? "Volunteer" : "Donor";
    var roleIcon = isStaff ? "bi-shield-lock" : isVolunteer ? "bi-person-check" : "bi-heart";
}

<div class="dash-sidebar-inner">
    <a class="dash-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
        <img src="~/images/logo.svg" alt="Gift of the Givers logo" height="34" width="34" />
        <span>Gift of the <span style="color: var(--accent-400);">Givers</span></span>
    </a>

    <span class="dash-role-badge"><i class="bi @roleIcon me-1"></i>@roleName dashboard</span>

    <nav class="dash-nav">
        @if (isStaff)
        {
            <div class="dash-nav-section">Manage</div>
            <a class="@(active=="projects"?"active":"")" asp-area="Staff" asp-controller="Projects" asp-action="Index"><i class="bi bi-box-seam"></i> Relief projects</a>
            <a class="@(active == "overview" ? "active" : "")" asp-area="Staff" asp-controller="Staff" asp-action="Dashboard">
                <i class="bi bi-speedometer2"></i> Overview
            </a>
            <a class="@(active == "volunteers" ? "active" : "")" asp-area="Staff" asp-controller="Staff" asp-action="Volunteers">
                <i class="bi bi-people"></i> Volunteer applications
            </a>
            <a class="@(active == "updates" ? "active" : "")" asp-area="Staff" asp-controller="Staff" asp-action="Updates">
                <i class="bi bi-megaphone"></i> Post field update
            </a>
            <a class="@(active == "donations" ? "active" : "")" asp-area="Staff" asp-controller="Staff" asp-action="Donations">
                <i class="bi bi-heart"></i> Donations
            </a>
            <a class="@(active=="audit"?"active":"")" asp-area="Staff" asp-controller="Staff" asp-action="Audit"><i class="bi bi-clock-history"></i> Audit history</a>
            <a class="@(active=="diagnostics"?"active":"")" asp-area="Staff" asp-controller="Staff" asp-action="Diagnostics"><i class="bi bi-activity"></i> Service diagnostics</a>
        }
        else if (isVolunteer)
        {
            <div class="dash-nav-section">My area</div>
            <a class="@(active == "overview" ? "active" : "")" asp-area="Volunteer" asp-controller="VolunteerDashboard" asp-action="Dashboard">
                <i class="bi bi-speedometer2"></i> Overview
            </a>
            <a class="@(active == "application" ? "active" : "")" asp-area="Volunteer" asp-controller="VolunteerDashboard" asp-action="MyApplication">
                <i class="bi bi-clipboard-check"></i> My application
            </a>
            <a class="@(active == "updates" ? "active" : "")" asp-area="Volunteer" asp-controller="VolunteerDashboard" asp-action="Updates">
                <i class="bi bi-newspaper"></i> Relief updates
            </a>
        }
        else
        {
            <div class="dash-nav-section">Your giving</div>
            <a class="@(active=="donor-overview"?"active":"")" asp-area="" asp-controller="Donor" asp-action="Index"><i class="bi bi-grid"></i> Overview</a>
            <a class="@(active=="contributions"?"active":"")" asp-area="" asp-controller="Donations" asp-action="MyDonations"><i class="bi bi-clock-history"></i> Contribution history</a>
            <a class="@(active=="donate"?"active":"")" asp-area="" asp-controller="Donations" asp-action="Create"><i class="bi bi-plus-circle"></i> Make a contribution</a>
            <a asp-area="" asp-controller="Projects" asp-action="Index"><i class="bi bi-box-seam"></i> Explore projects</a>
            <a class="@(active=="notifications"?"active":"")" asp-area="" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell"></i> Notifications</a>
        }
    </nav>

    <div class="dash-sidebar-bottom">
        <div class="dash-nav-section">General</div>
        <nav class="dash-nav mb-2">
            <a asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-globe2"></i> View public site</a>
            <a asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-gear"></i> Account settings</a>
        </nav>
        <form asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="dash-logout"><i class="bi bi-box-arrow-right"></i> Log out</button>
        </form>
    </div>
</div>

@model GiftOfTheGivers.Helpers.Models.Volunteer
@{
    ViewData["Title"] = "Thank you";
}

<div class="container my-5">
    <div class="card feature-card mx-auto" style="max-width: 640px;">
        <div class="card-body p-5 text-center">
            <div class="state-icon"><i class="bi bi-check-lg"></i></div>
            <h1 class="h3 mb-1">Thank you, @Model.FullName!</h1>
            <p class="text-muted mb-4">Your volunteer application has been received.</p>

            <div class="text-start bg-light rounded-3 p-3 mb-4" style="background: var(--brand-50) !important; border: 1px solid var(--brand-100);">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Email</span><span class="fw-semibold small">@Model.Email</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Phone</span><span class="fw-semibold small">@Model.Phone</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Availability</span>
                    <span><span class="badge badge-soft">@Model.Availability</span></span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Skills</span>
                    <span class="fw-semibold small text-end" style="max-width: 60%;">@(string.IsNullOrEmpty(Model.Skills) ? "Not specified" : Model.Skills)</span>
                </div>
            </div>

            <h2 class="h6 text-uppercase mb-3" style="letter-spacing: .1em; color: var(--ink-500);">What happens next</h2>
            <div class="d-flex flex-column gap-2 text-start small mb-4" style="max-width: 400px; margin-inline: auto;">
                <div class="d-flex gap-3 align-items-center">
                    <span class="badge badge-soft rounded-circle" style="width: 28px; height: 28px; display: inline-grid; place-items: center;">1</span>
                    Our staff review volunteer sign-ups on the dashboard.
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <span class="badge badge-soft rounded-circle" style="width: 28px; height: 28px; display: inline-grid; place-items: center;">2</span>
                    We match you to opportunities based on skills and availability.
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <span class="badge badge-soft rounded-circle" style="width: 28px; height: 28px; display: inline-grid; place-items: center;">3</span>
                    We contact you about upcoming relief efforts.
                </div>
            </div>

            <a class="btn btn-gotg px-4" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house me-1"></i> Back to home
            </a>
            <a class="btn btn-outline-secondary px-4" asp-area="" asp-controller="Volunteers" asp-action="Create">
                Sign up again
            </a>
        </div>
    </div>
</div>

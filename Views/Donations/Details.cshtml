@model GiftOfTheGivers.Helpers.Models.Donation
@{ ViewData["Title"] = "Donation details"; }
<div class="container py-5">
    <h1>Donation details</h1>
    <dl class="row">
        <dt class="col-sm-3">Reference</dt><dd class="col-sm-9">@Model.ReferenceNumber</dd>
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.DonorName</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Amount</dt><dd class="col-sm-9">@Model.Currency @Model.Amount.ToString("N2")</dd>
        <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.DonationDate.ToString("dd MMM yyyy")</dd>
    </dl>
    <a asp-action="Certificate" asp-route-id="@Model.Id" class="btn btn-gotg">View prototype receipt</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to records</a>
</div>

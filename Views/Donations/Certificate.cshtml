@model GiftOfTheGivers.Helpers.Models.Donation
@{
    ViewData["Title"] = "Tax Certificate";
    var cert = ViewBag.TaxCertificate as GiftOfTheGivers.Services.TaxCertificateResult;
    var formattedAmount = ViewBag.FormattedAmount as string ?? ($"R {Model.Amount:N2}");
    var taxRelief = ViewBag.TaxRelief as string ?? ($"R {(Model.Amount * 0.28m):N2}");
    var tier = ViewBag.DonorTier as string ?? "Supporter";
}

<div class="container my-4 my-lg-5">
    <!-- Header / Nav (hidden when printing) -->
    <div class="text-center mb-4 print-hide">
        <div class="state-icon" style="width: 68px; height: 68px; font-size: 1.8rem; margin-bottom: .8rem;">
            <i class="bi bi-patch-check-fill text-success"></i>
        </div>
        <h1 class="h2 mb-1">Thank you, @Model.DonorName!</h1>
        <p class="text-muted mb-3">
            Your donation has been recorded. This is a prototype receipt. No payment has been processed.
        </p>
        
        <!-- Cloud / Azure Functions Status Badge -->
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" 
             style="background: @(cert?.IsCloudGenerated == true ? "#ecfdf5" : "#f1f5f9"); border: 1px solid @(cert?.IsCloudGenerated == true ? "#a7f3d0" : "#cbd5e1"); font-size: 0.85rem;">
            @if (cert?.IsCloudGenerated == true)
            {
                <i class="bi bi-cloud-check-fill text-success"></i>
                <span class="text-success fw-semibold">Cloud generated: Generated by Azure Function (HTTP Trigger: GenerateTaxCertificate)</span>
            }
            else
            {
                <i class="bi bi-gear-fill text-secondary"></i>
                <span class="text-secondary fw-semibold">Local Generation: Formatted with GiftOfTheGivers.Helpers</span>
            }
        </div>
        
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-outline-secondary btn-sm" asp-area="" asp-controller="Donations" asp-action="Create">
                <i class="bi bi-arrow-left me-1"></i> Make another donation
            </a>
            <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#cloudDebug">
                <i class="bi bi-code-slash me-1"></i> View Azure Function Response
            </button>
        </div>

        <!-- Collapsible Cloud Response (for demonstration and screenshots) -->
        <div class="collapse mt-3 mx-auto text-start" id="cloudDebug" style="max-width: 780px;">
            <div class="card bg-light border shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2">
                    <span class="small fw-semibold"><i class="bi bi-cloud-arrow-down me-1"></i> Azure Function HTTP Payload</span>
                    <button class="btn btn-sm btn-outline-light py-0 px-2" onclick="refreshCloudCertificate()">
                        <i class="bi bi-arrow-clockwise me-1"></i> Re-test Live Endpoint
                    </button>
                </div>
                <div class="card-body p-3">
                    <div class="small text-muted mb-2">
                        <strong>Endpoint:</strong> <code>@(_taxCertService?.FunctionEndpointUrl ?? "http://localhost:7071/api/tax-certificate")</code>
                    </div>
                    <pre class="bg-white p-2 rounded border small mb-0" id="jsonPayload" style="max-height: 200px; overflow-y: auto;">@System.Text.Json.JsonSerializer.Serialize(cert, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
                </div>
            </div>
        </div>
    </div>

    <!-- Printable Prototype Receipt -->
    <div class="certificate mx-auto" id="certificate">
        <img src="~/images/logo.svg" alt="" class="watermark" />

        <div class="cert-top">
            <img src="~/images/logo.svg" alt="Gift of the Givers logo" width="56" height="56" />
            <div>
                <h1>Gift of the Givers Foundation</h1>
                <p>Non-Profit Organisation · Student demonstration</p>
            </div>
        </div>

        <div class="cert-title">PROTOTYPE DONATION RECEIPT</div>

        <p class="cert-intro mb-1">This is to certify that</p>
        <h2 class="cert-name">@Model.DonorName</h2>
        <p class="cert-email mb-2">@Model.Email</p>
        
        <div class="text-center mb-3">
            <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill small">
                Donor Status: <strong>@tier</strong>
            </span>
        </div>

        <p class="text-center text-muted small mb-0">submitted a demonstration donation record for</p>
        <div class="cert-amount">@formattedAmount</div>
        <div class="text-center mb-3">
            <span class="small text-muted">This receipt does not establish tax eligibility.</span>
        </div>

        <p class="text-center text-muted small">
            @(Model.IsRecurring ? "Monthly recurring contribution" : "One-time contribution") · No goods or services were received in exchange.
        </p>

        <div class="cert-details">
            <div>
                <div class="cd-label">Certificate No</div>
                <div class="cd-value fw-bold text-teal">@Model.ReferenceNumber</div>
            </div>
            <div>
                <div class="cd-label">Date of Donation</div>
                <div class="cd-value">@Model.DonationDate.ToString("dd MMMM yyyy")</div>
            </div>
            <div>
                <div class="cd-label">Contribution Type</div>
                <div class="cd-value">@(Model.IsRecurring ? "Recurring" : "One-time")</div>
            </div>
            <div>
                <div class="cd-label">Record checksum</div>
                <div class="cd-value font-monospace small">@(cert?.VerificationHash ?? "VERIFIED")</div>
            </div>
        </div>

        <p class="cert-note">Student prototype · Not affiliated with the real foundation.
            No payment processed. Not a valid tax certificate. A checksum does not verify payment or authenticity.</p>
    </div>

    <!-- Actions (hidden when printing) -->
    <div class="text-center my-4 print-hide">
        <button type="button" class="btn btn-gotg btn-lg px-4" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print / Save as PDF
        </button>
        <a class="btn btn-outline-secondary btn-lg px-4" asp-area="" asp-controller="Home" asp-action="Index">Back to home</a>
    </div>
</div>

@inject GiftOfTheGivers.Services.ITaxCertificateService _taxCertService

<script>
    async function refreshCloudCertificate() {
        const pre = document.getElementById('jsonPayload');
        pre.innerText = "Querying Azure Function...";
        try {
            const res = await fetch('@Url.Action("CloudCertificate", "Donations", new { id = Model.Id })');
            const data = await res.json();
            pre.innerText = JSON.stringify(data, null, 2);
        } catch (err) {
            pre.innerText = "Error querying endpoint: " + err;
        }
    }
</script>


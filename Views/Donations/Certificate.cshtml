@model GiftOfTheGivers.Helpers.Models.Donation
@{ViewData["Title"]="Donation confirmation";ViewData["ActivePage"]="Donate";var reference=string.IsNullOrEmpty(Model.ReferenceNumber)?GiftOfTheGivers.Helpers.TaxCertificateHelper.FormatCertificateNumber(Model.Id,Model.DonationDate):Model.ReferenceNumber;}
<div class="container py-5"><ol class="donation-steps print-hide" aria-label="Donation steps"><li class="complete"><span>1</span> Details</li><li class="complete"><span>2</span> Review</li><li aria-current="step"><span>3</span> Confirmation</li></ol>
<div class="text-center mb-4 print-hide"><div class="confirmation-icon"><i class="bi bi-check-lg" aria-hidden="true"></i></div><h1 class="h2">Thank you, @Model.DonorName</h1><p class="text-muted">Your demo contribution has been recorded.</p></div>
<div class="card receipt-card p-4 p-md-5 mx-auto"><div class="d-flex justify-content-between gap-3 align-items-center mb-4"><img src="~/images/logo.svg" width="48" height="48" alt="Relief portal logo" /><span class="badge badge-amber">Demo receipt</span></div><h2 class="h4">Contribution record</h2><div class="review-amount my-3">@Model.Currency @Model.Amount.ToString("N2")</div><dl class="review-details"><div><dt>Reference</dt><dd>@reference</dd></div><div><dt>Donor</dt><dd>@Model.DonorName</dd></div><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Project</dt><dd>@(Model.ReliefProject?.Name??"General relief fund")</dd></div><div><dt>Recorded</dt><dd>@Model.DonationDate.ToString("dd MMM yyyy, HH:mm") UTC</dd></div><div><dt>Preference</dt><dd>@(Model.IsRecurring?"Monthly (no billing)":"One-time")</dd></div></dl></div>
<div class="d-flex flex-wrap gap-2 justify-content-center mt-4 print-hide"><a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-gotg"><i class="bi bi-download me-2" aria-hidden="true"></i>Download PDF receipt</a><button class="btn btn-soft" type="button" onclick="window.print()">Print receipt</button>@if(User.Identity?.IsAuthenticated==true){<a asp-action="MyDonations" class="btn btn-soft">Contribution history</a>@if(User.IsInRole("Donor")){<a asp-controller="Donor" asp-action="Index" class="btn btn-soft">My dashboard</a>}}<a asp-controller="Projects" asp-action="Index" class="btn btn-soft">Explore projects</a></div><p class="small text-center text-muted mt-3 print-hide">Guest receipts are available in this browser for 24 hours. Download a copy for your records.</p></div>

@model GiftOfTheGivers.Helpers.Models.ViewModels.DonationInput
@{ViewData["Title"]="Record a demo donation";ViewData["ActivePage"]="Donate";}
<div class="container py-5"><div class="text-center mb-4"><span class="eyebrow">Your support, your choice</span><h1 class="mt-2">Make a difference</h1><p class="text-muted">Choose a project and review your details before submitting.</p></div>
<ol class="donation-steps" aria-label="Donation steps"><li aria-current="step"><span>1</span> Details</li><li><span>2</span> Review</li><li><span>3</span> Confirmation</li></ol>
<partial name="_Flash" />
<div class="row g-4 justify-content-center"><div class="col-lg-7"><form asp-action="Review" method="post" class="card feature-card p-4 p-md-5 needs-validation" novalidate>
<div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div><input asp-for="SubmissionKey" type="hidden" />
<h2 class="h4">Your contribution</h2><p class="demo-note">Student prototype · No real payment is collected.</p>
<div class="mb-3"><label asp-for="ReliefProjectId" class="form-label"></label><select asp-for="ReliefProjectId" class="form-select" asp-items="@(new SelectList(ViewBag.Projects,"Id","Name"))"><option value="">General relief fund</option></select><span asp-validation-for="ReliefProjectId" class="text-danger small"></span></div>
<div class="row g-3 mb-3"><div class="col-md-7"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control form-control-lg" type="number" min="1" max="1000000" step="0.01" placeholder="250.00" /><span asp-validation-for="Amount" class="text-danger small"></span></div><div class="col-md-5"><label asp-for="Currency" class="form-label"></label><select asp-for="Currency" class="form-select form-select-lg"><option>ZAR</option><option>USD</option><option>EUR</option></select><span asp-validation-for="Currency" class="text-danger small"></span></div></div>
<div class="amount-choices mb-4" aria-label="Suggested amounts">@foreach(var amount in new[]{50,100,250,500}){<button type="button" class="amount-chip" data-set-amount="@amount">@amount</button>}</div>
<div class="form-check mb-4"><input asp-for="IsRecurring" class="form-check-input" /><label asp-for="IsRecurring" class="form-check-label">Monthly contribution preference</label><div class="form-text">Stores your preference only. No recurring charge is created.</div></div>
<h2 class="h4 border-top pt-4">Your details</h2><div class="mb-3"><label asp-for="DonorName" class="form-label"></label><input asp-for="DonorName" class="form-control" autocomplete="name" /><span asp-validation-for="DonorName" class="text-danger small"></span></div><div class="mb-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span></div>
<button class="btn btn-gotg btn-lg" type="submit">Review contribution <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i></button>
</form></div><div class="col-lg-4"><aside class="card contribution-aside p-4"><div class="icon-tile mb-3"><i class="bi bi-heart" aria-hidden="true"></i></div><h2 class="h4">Know what happens next</h2><ol class="next-steps"><li>Review your amount, currency, and project.</li><li>Confirm your demo submission.</li><li>Download a receipt and follow project updates.</li></ol><p class="small text-muted mb-0">Your email is used for submission updates. No payment details are requested.</p></aside></div></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial" />}

@model GiftOfTheGivers.Helpers.Models.ViewModels.DonorDashboardViewModel
@{ViewData["Title"]="My contributions";ViewData["ActivePage"]="MyDonations";}
<section class="page-heading"><div class="container"><span class="eyebrow">Your contribution history</span><h1>Your support, in one place</h1><p>Review your demo records and download receipts.</p></div></section><div class="container py-5"><div class="section-toolbar"><p class="demo-note mb-0">@Model.ContributionCount demo records · @Model.RecurringCount monthly preferences · No payments collected</p><a asp-action="Create" class="btn btn-gotg">New contribution</a></div>
<div class="row g-3 mb-4">@foreach(var total in Model.Totals){<div class="col-md-4"><div class="card stat-card p-4"><span class="eyebrow">@total.Currency contributions</span><strong class="h3 mt-2">@total.Currency @total.Total.ToString("N2")</strong><span class="small text-muted">@total.Count records · Average @total.Average.ToString("N2")</span></div></div>}</div>
<form method="get" class="filter-bar mb-4"><div><label for="currency" class="form-label">Currency</label><select id="currency" name="currency" class="form-select"><option value="">All currencies</option>@foreach(var currency in new[]{"ZAR","USD","EUR"}){<option selected="@(Context.Request.Query["currency"]==currency)">@currency</option>}</select></div><button class="btn btn-gotg">Apply</button><a asp-action="MyDonations" class="btn btn-soft">Reset</a></form>
@if(Model.Donations.Items.Count==0){<div class="empty-state"><i class="bi bi-heart" aria-hidden="true"></i><h2 class="h4">Your contribution story starts here</h2><p>Record a demo contribution to see its receipt and project here.</p><a asp-controller="Projects" asp-action="Index" class="btn btn-gotg">Explore projects</a></div>}
else{<div class="card table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Reference / Project</th><th>Date</th><th>Amount</th><th>Preference</th><th>Receipt</th></tr></thead><tbody>@foreach(var item in Model.Donations.Items){<tr><td><strong>@item.ReferenceNumber</strong><div class="small text-muted">@(item.ReliefProject?.Name??"General relief fund")</div></td><td>@item.DonationDate.ToString("dd MMM yyyy")</td><td class="fw-bold text-nowrap">@item.Currency @item.Amount.ToString("N2")</td><td>@(item.IsRecurring?"Monthly preference":"One-time")</td><td><a asp-action="Certificate" asp-route-id="@item.Id" class="btn btn-soft btn-sm">View</a> <a asp-action="Download" asp-route-id="@item.Id" class="btn btn-soft btn-sm">PDF</a></td></tr>}</tbody></table></div>}
<partial name="_Pagination" model="Model.Donations" /><p class="small text-muted mt-3">Guest submissions are not linked to your account. Totals are grouped by currency; no exchange rates are applied.</p></div>

@model GiftOfTheGivers.Helpers.Models.ViewModels.DonationReviewViewModel
@{ViewData["Title"]="Review contribution";ViewData["ActivePage"]="Donate";}
<div class="container py-5"><ol class="donation-steps" aria-label="Donation steps"><li class="complete"><span>1</span> Details</li><li aria-current="step"><span>2</span> Review</li><li><span>3</span> Confirmation</li></ol>
<div class="review-card card p-4 p-md-5 mx-auto"><span class="eyebrow">One last check</span><h1 class="h2 mt-2">Review your contribution</h1><p class="text-muted">Confirm that these details are correct.</p><div class="review-amount">@Model.Donation.Currency @Model.Donation.Amount.ToString("N2")</div><p class="text-muted">@(Model.Donation.IsRecurring?"Monthly preference · No billing":"One-time demo record")</p>
<dl class="review-details"><div><dt>Project</dt><dd>@Model.ProjectName</dd></div><div><dt>Name</dt><dd>@Model.Donation.DonorName</dd></div><div><dt>Email</dt><dd>@Model.Donation.Email</dd></div></dl><p class="demo-note">No money will be taken. This submission is a demo record and does not qualify as a tax receipt.</p>
<form asp-action="Create" method="post"><input type="hidden" name="reviewToken" value="@Model.ReviewToken" /><button class="btn btn-gotg btn-lg w-100" type="submit">Confirm demo contribution</button></form>
<button class="btn btn-soft mt-2" type="button" data-back-to-details>Back to edit details</button><noscript><p class="mt-2"><a asp-action="Create">Start again to edit details</a></p></noscript><p class="small text-muted mt-3 mb-0">This review expires after 30 minutes. Repeated confirmation will not create another record.</p></div></div>

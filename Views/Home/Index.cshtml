@model GiftOfTheGivers.Helpers.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["ActivePage"] = "Home";
}

<!-- ============================== HERO ============================== -->
<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="eyebrow">South Africa · Disaster relief</span>
                <h1 class="display-4 fw-bold mt-3 mb-3" style="font-size: clamp(2.1rem, 4.2vw, 3.2rem);">
                    Be the hands that give hope.
                </h1>
                <p class="lead mb-4" style="max-width: 520px;">
                    We deliver food, water, shelter and medical care to communities on
                    their worst day. Your donation or your time makes that possible.
                </p>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <a class="btn btn-accent btn-lg px-4" asp-area="" asp-controller="Donations" asp-action="Create">
                        <i class="bi bi-heart-fill me-1"></i> Donate now
                    </a>
                    <a class="btn btn-outline-light btn-lg px-4" asp-area="" asp-controller="Volunteers" asp-action="Create">
                        <i class="bi bi-person-plus me-1"></i> Become a volunteer
                    </a>
                </div>
                <div class="trust-row">
                    <span class="trust-item"><i class="bi bi-patch-check-fill"></i> Instant tax certificate</span>
                    <span class="trust-item"><i class="bi bi-shield-check"></i> Guest donations welcome</span>
                    <span class="trust-item"><i class="bi bi-credit-card"></i> No payment details collected</span>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="hero-visual">
                    <div class="hv-ring"></div>
                    <div class="hv-card hv-card-1">
                        <div class="hv-icon"><i class="bi bi-heart-fill"></i></div>
                        <div>
                            <div class="hv-amount">R 2 500.00</div>
                            <div class="hv-label">Monthly donation received</div>
                            <div class="hv-sub"><i class="bi bi-patch-check-fill"></i> Tax certificate issued</div>
                        </div>
                    </div>
                    <div class="hv-card hv-card-2">
                        <div class="hv-icon alt"><i class="bi bi-person-plus-fill"></i></div>
                        <div>
                            <div class="hv-label fw-semibold">New volunteer on board</div>
                            <div class="hv-sub">First Aid · Weekends</div>
                        </div>
                    </div>
                    <div class="hv-pill"><i class="bi bi-shield-check"></i> Secure &amp; verified</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== LIVE STATS STRIP ===================== -->
<section class="container stats-strip">
    <div class="row g-3">
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="stat-icon"><i class="bi bi-heart"></i></div>
                    <div class="stat-value"><span data-count="@Model.DonationCount">0</span></div>
                    <div class="stat-label">donations received</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="stat-icon"><i class="bi bi-cash-coin"></i></div>
                    <div class="stat-value"><span class="me-1">R</span><span data-count="@Model.TotalDonatedZar" data-decimals="0">0</span></div>
                    <div class="stat-label">raised (ZAR)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="stat-icon"><i class="bi bi-people"></i></div>
                    <div class="stat-value"><span data-count="@Model.VolunteerCount">0</span></div>
                    <div class="stat-label">volunteers signed up</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="stat-icon"><i class="bi bi-box-seam"></i></div>
                    <div class="stat-value"><span data-count="@Model.ProjectCount">0</span></div>
                    <div class="stat-label">active relief projects</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== HOW YOU CAN HELP ===================== -->
<section class="section">
    <div class="container">
        <div class="section-head text-center mb-5">
            <span class="eyebrow" style="justify-content: center;">Ways to help</span>
            <h2>How you can make a difference</h2>
            <p class="section-sub mx-auto mt-2">
                Three simple ways to be part of the relief effort — each takes minutes,
                and every contribution is recorded.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card feature-card">
                    <div class="card-body p-4">
                        <div class="icon-tile"><i class="bi bi-heart"></i></div>
                        <h3 class="h5 mb-2">Donate</h3>
                        <p class="small text-muted mb-3">
                            One-time or monthly, in ZAR, USD or EUR. Every gift is saved in
                            our records and you instantly receive a printable tax certificate.
                        </p>
                        <a class="btn btn-gotg btn-sm px-3" asp-area="" asp-controller="Donations" asp-action="Create">
                            Make a donation <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-card">
                    <div class="card-body p-4">
                        <div class="icon-tile amber"><i class="bi bi-people"></i></div>
                        <h3 class="h5 mb-2">Volunteer</h3>
                        <p class="small text-muted mb-3">
                            Share your skills — first aid, logistics, cooking, counselling
                            and more — and tell us when you're available to help.
                        </p>
                        <a class="btn btn-gotg btn-sm px-3" asp-area="" asp-controller="Volunteers" asp-action="Create">
                            Sign up to volunteer <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card feature-card">
                    <div class="card-body p-4">
                        <div class="icon-tile"><i class="bi bi-megaphone"></i></div>
                        <h3 class="h5 mb-2">Follow our work</h3>
                        <p class="small text-muted mb-3">
                            Our teams post live updates from relief projects across the
                            country — see exactly where your support is going.
                        </p>
                        <a class="btn btn-soft btn-sm px-3" asp-area="" asp-controller="Home" asp-action="About">
                            Learn about us <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== LATEST UPDATES ===================== -->
<section class="section section-alt">
    <div class="container">
        <div class="section-head d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <span class="eyebrow">From the field</span>
                <h2 class="mt-2 mb-0">Latest updates</h2>
            </div>
            @if (User.IsInRole("Staff"))
            {
                <a class="btn btn-soft btn-sm" asp-area="Staff" asp-controller="Staff" asp-action="Updates">
                    <i class="bi bi-pencil-square me-1"></i> Post an update
                </a>
            }
        </div>

        @if (!Model.LatestUpdates.Any())
        {
            <div class="card">
                <div class="card-body text-muted py-5 text-center">
                    <i class="bi bi-newspaper display-6 d-block mb-3" style="color: var(--ink-400);"></i>
                    Updates from our teams on the ground will appear here.
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var update in Model.LatestUpdates)
                {
                    <div class="col-md-4">
                        <div class="card update-card">
                            <div class="update-body">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge badge-soft"><i class="bi bi-geo-alt me-1"></i>@update.ReliefProject?.Name</span>
                                </div>
                                <h3 class="h6 mb-2">@update.Title</h3>
                                <p class="small text-muted mb-3">@update.Body</p>
                                <div class="update-meta d-flex align-items-center gap-2">
                                    <span class="avatar" style="width: 26px; height: 26px; font-size: .68rem;">@(update.PostedByName?.FirstOrDefault().ToString().ToUpperInvariant() ?? "G")</span>
                                    <span>@update.PostedByName</span>
                                    <span>·</span>
                                    <span>@update.PostedAt.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- ===================== CTA BAND ===================== -->
<section class="section">
    <div class="container">
        <div class="cta-band">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="eyebrow">Take action today</span>
                    <h2 class="mt-2 mb-2">Ready to make a difference?</h2>
                    <p class="mb-0" style="max-width: 560px;">
                        Whether it's a monthly gift or a weekend of your time,
                        the people we serve are counting on people like you.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a class="btn btn-accent btn-lg px-4 me-2 mb-2" asp-area="" asp-controller="Donations" asp-action="Create">Donate now</a>
                    <a class="btn btn-outline-light btn-lg px-4 mb-2" asp-area="" asp-controller="Volunteers" asp-action="Create">Volunteer</a>
                </div>
            </div>
        </div>
    </div>
</section>

@{
    ViewData["Title"] = "About";
    ViewData["ActivePage"] = "About";
}

<section class="hero" style="padding: 3.4rem 0 4rem;">
    <div class="container">
        <span class="eyebrow">Who we are</span>
        <h1 class="display-5 fw-bold mt-3 mb-3">About Gift of the Givers</h1>
        <p class="lead mb-0" style="max-width: 640px;">
            One of Africa's largest disaster-relief organisations — and the community
            of donors and volunteers that powers it.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-7">
                <span class="eyebrow">Our mission</span>
                <h2 class="mt-2 mb-3">Aid and hope, without exception</h2>
                <p>
                    When floods, fires, droughts or crises strike, we are among the first on
                    the scene — and we stay until communities are back on their feet. Our
                    mission is to deliver <strong>aid and hope</strong> to people in need,
                    regardless of race, religion or nationality.
                </p>
                <p>
                    This website is where the public meets the mission: make a donation
                    (one-time or monthly), sign up as a volunteer, and follow the latest
                    updates our staff post from relief projects across the country.
                </p>

                <h3 class="h5 mt-4 mb-3">What we do</h3>
                <div class="row g-3">
                    @foreach (var item in new[]
                    {
                        ("bi-basket", "Emergency food, water and clothing parcels"),
                        ("bi-heart-pulse", "Medical care and first-aid response"),
                        ("bi-house-door", "Temporary shelter and rebuilding support"),
                        ("bi-chat-heart", "Counselling and psychosocial support"),
                        ("bi-droplet", "Drought and water-security projects"),
                        ("bi-journal-bookmark", "Education and skills programmes")
                    })
                    {
                        <div class="col-md-6">
                            <div class="card feature-card h-100">
                                <div class="card-body d-flex align-items-start gap-3 p-3">
                                    <div class="icon-tile" style="width: 42px; height: 42px; font-size: 1.1rem; margin-bottom: 0; flex: 0 0 auto;"><i class="bi @item.Item1"></i></div>
                                    <p class="mb-0 small" style="padding-top: .45rem;">@item.Item2</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card feature-card">
                    <div class="card-body p-4">
                        <span class="eyebrow">Our values</span>
                        <h3 class="h5 mt-2 mb-0">What guides us</h3>
                        <hr class="my-3" style="border-color: var(--line);" />
                        <div class="d-flex gap-3 mb-3">
                            <div class="icon-tile" style="width: 40px; height: 40px; font-size: 1rem; margin-bottom: 0;"><i class="bi bi-heart"></i></div>
                            <div><strong>Compassion</strong><p class="small text-muted mb-0">We treat every person with dignity.</p></div>
                        </div>
                        <div class="d-flex gap-3 mb-3">
                            <div class="icon-tile amber" style="width: 40px; height: 40px; font-size: 1rem; margin-bottom: 0;"><i class="bi bi-lightning-charge"></i></div>
                            <div><strong>Speed</strong><p class="small text-muted mb-0">In a disaster, every hour matters.</p></div>
                        </div>
                        <div class="d-flex gap-3 mb-3">
                            <div class="icon-tile" style="width: 40px; height: 40px; font-size: 1rem; margin-bottom: 0;"><i class="bi bi-eye"></i></div>
                            <div><strong>Transparency</strong><p class="small text-muted mb-0">Donors see exactly how their gift is used.</p></div>
                        </div>
                        <div class="d-flex gap-3">
                            <div class="icon-tile amber" style="width: 40px; height: 40px; font-size: 1rem; margin-bottom: 0;"><i class="bi bi-people"></i></div>
                            <div><strong>Community</strong><p class="small text-muted mb-0">We are powered by volunteers and donors.</p></div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-light border mt-3 mb-0 small" style="border-radius: var(--radius-md);">
                    <i class="bi bi-info-circle me-1" style="color: var(--brand-600);"></i>
                    <strong>Note:</strong> this website is a student prototype built for a
                    software development assignment. It is not affiliated with the real
                    Gift of the Givers Foundation and no real money is processed.
                </div>
            </div>
        </div>
    </div>
</section>

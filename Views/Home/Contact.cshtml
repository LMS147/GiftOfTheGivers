@{
    ViewData["Title"] = "Contact";
    ViewData["ActivePage"] = "Contact";
}

<section class="hero" style="padding: 3.4rem 0 4rem;">
    <div class="container">
        <span class="eyebrow">Get in touch</span>
        <h1 class="display-5 fw-bold mt-3 mb-3">Contact us</h1>
        <p class="lead mb-0" style="max-width: 620px;">
            Questions about a donation, a volunteer application or one of our relief
            projects? We'd love to hear from you.
        </p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card h-100">
                    <div class="card-body p-4 text-center">
                        <div class="icon-tile mx-auto"><i class="bi bi-envelope"></i></div>
                        <h2 class="h6 mt-3">Email</h2>
                        <p class="small text-muted mb-0">
                            info@gotg.example<br />donate@gotg.example
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card h-100">
                    <div class="card-body p-4 text-center">
                        <div class="icon-tile amber mx-auto"><i class="bi bi-telephone"></i></div>
                        <h2 class="h6 mt-3">Phone</h2>
                        <p class="small text-muted mb-0">
                            +27 (0)11 000 0000<br />Emergency: 0800 000 000
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card h-100">
                    <div class="card-body p-4 text-center">
                        <div class="icon-tile mx-auto"><i class="bi bi-geo-alt"></i></div>
                        <h2 class="h6 mt-3">Head office</h2>
                        <p class="small text-muted mb-0">
                            12 Hope Street<br />Johannesburg, 2001
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card feature-card h-100">
                    <div class="card-body p-4 text-center">
                        <div class="icon-tile amber mx-auto"><i class="bi bi-clock"></i></div>
                        <h2 class="h6 mt-3">Office hours</h2>
                        <p class="small text-muted mb-0">
                            Mon–Fri: 08:00 – 17:00<br />Sat: 08:00 – 13:00
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="alert alert-light border small mt-4" style="border-radius: var(--radius-md); max-width: 720px; margin-inline: auto;">
            <i class="bi bi-info-circle me-1" style="color: var(--brand-600);"></i>
            <strong>Note:</strong> contact details on this page are fictional — this is a
            student prototype website.
        </div>
    </div>
</section>

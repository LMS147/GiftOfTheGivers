<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Official Public NuGet Repository -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    
    <!-- Local packages directory containing GiftOfTheGivers.Helpers.1.0.0.nupkg -->
    <add key="LocalFeed" value="./nupkg" />

    <!-- SECTION D: Azure DevOps Artifacts Feed -->
    <!-- Uncomment and replace with your Azure DevOps Organization and Feed name when ready: -->
    <!--
    <add key="GiftOfTheGiversFeed" value="https://pkgs.dev.azure.com/YOUR-ORGANIZATION/_packaging/GiftOfTheGiversFeed/nuget/v3/index.json" />
    -->
  </packageSources>

  <packageSourceCredentials>
    <!-- Authentication credentials for Azure Artifacts feed (or use Azure Artifacts Credential Provider) -->
    <!--
    <GiftOfTheGiversFeed>
      <add key="Username" value="AzureDevOps" />
      <add key="ClearTextPassword" value="YOUR-PERSONAL-ACCESS-TOKEN" />
    </GiftOfTheGiversFeed>
    -->
  </packageSourceCredentials>
</configuration>

@model GiftOfTheGivers.Helpers.Models.ViewModels.StaffUpdatesViewModel
@{
    ViewData["Title"] = "Post Field Update";
    ViewData["NavActive"] = "updates";
}

<h1 class="h4 mb-4">Share news from the field</h1>

@if (TempData["Flash"] is string flash)
{
    <div class="flash mb-4" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@flash</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card feature-card">
            <div class="card-body p-4">
                <h2 class="h6 mb-3"><i class="bi bi-megaphone me-2" style="color: var(--brand-600);"></i>New update</h2>
                <form asp-area="Staff" asp-controller="Staff" asp-action="PostUpdate" method="post" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="NewUpdate.ReliefProjectId" class="form-label"></label>
                        <select asp-for="NewUpdate.ReliefProjectId" class="form-select"
                                asp-items="@(new SelectList(Model.Projects, "Id", "Name"))">
                            <option value="">— Select a project —</option>
                        </select>
                        <span asp-validation-for="NewUpdate.ReliefProjectId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewUpdate.Title" class="form-label"></label>
                        <input asp-for="NewUpdate.Title" class="form-control" placeholder="e.g. 2 000 food parcels delivered" />
                        <span asp-validation-for="NewUpdate.Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewUpdate.Body" class="form-label"></label>
                        <textarea asp-for="NewUpdate.Body" class="form-control" rows="4"
                                  placeholder="What happened on the ground today?"></textarea>
                        <span asp-validation-for="NewUpdate.Body" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-gotg px-4">
                        <i class="bi bi-send me-1"></i> Post update
                    </button>
                    <span class="small text-muted ms-2"><i class="bi bi-globe2 me-1"></i>Appears on the public home page.</span>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card feature-card">
            <div class="card-body p-4">
                <h2 class="h6 mb-3"><i class="bi bi-clock-history me-2" style="color: var(--brand-600);"></i>Recent updates</h2>
                @if (!Model.RecentUpdates.Any())
                {
                    <p class="text-muted small mb-0">Nothing posted yet — share the first update from the field.</p>
                }
                else
                {
                    @foreach (var u in Model.RecentUpdates)
                    {
                        <div class="card mb-2" style="border-color: var(--line); border-radius: var(--radius-md);">
                            <div class="card-body py-3">
                                <div class="d-flex justify-content-between flex-wrap gap-2 mb-1">
                                    <h3 class="h6 mb-0">
                                        @u.Title
                                        <span class="badge badge-soft ms-1"><i class="bi bi-geo-alt me-1"></i>@u.ReliefProject?.Name</span>
                                    </h3>
                                    <small class="text-muted">@u.PostedAt.ToString("dd MMM yyyy, HH:mm") · @u.PostedByName</small>
                                </div>
                                <p class="mb-0 small text-muted">@u.Body</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


<div class="container mb-4">
    <details>
        <summary>Cloud audit retries</summary>
        <p class="small text-muted">Retry an update after restoring Azure Functions or audit storage. Existing audit blobs are safely replaced.</p>
        @foreach (var update in Model.RecentUpdates)
        {
            <form asp-action="RetryAudit" method="post" class="d-flex gap-2 align-items-center mb-2">
                <input type="hidden" name="id" value="@update.Id" />
                <span>@update.Title</span>
                <button type="submit" class="btn btn-soft btn-sm">Retry cloud audit</button>
            </form>
        }
    </details>
</div>

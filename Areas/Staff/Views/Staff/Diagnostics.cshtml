@model GiftOfTheGivers.Helpers.Models.ViewModels.DiagnosticsViewModel
@{ViewData["Title"]="Service diagnostics";ViewData["NavActive"]="diagnostics";}
<h2 class="h3">Service diagnostics</h2><p class="text-muted">Configuration and notification delivery information. Credentials are never displayed.</p><partial name="_Flash" />
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card p-4 h-100"><h3 class="h6">Azure Functions</h3><strong>@(Model.FunctionsConfigured?"Configured":"Local mode")</strong><p class="small text-muted mb-0">Configuration status only; this does not confirm cloud availability.</p></div></div><div class="col-md-4"><div class="card p-4 h-100"><h3 class="h6">Email notifications</h3><strong>@(!Model.EmailEnabled?"Disabled":Model.EmailConfigured?"Configured":"Needs SMTP configuration")</strong><p class="small text-muted mb-0">In-app notifications work independently of email.</p></div></div><div class="col-md-4"><div class="card p-4 h-100"><h3 class="h6">Email queue</h3><strong>@Model.PendingEmailCount pending · @Model.FailedEmailCount need attention</strong><p class="small text-muted mb-0">Failed deliveries stop after five attempts.</p></div></div></div>
<h3 class="h5">Recent notification deliveries</h3><div class="card table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Notification</th><th>Recipient</th><th>Delivery</th><th>Action</th></tr></thead><tbody>@foreach(var item in Model.RecentDeliveries){<tr><td>@item.Subject<div class="small text-muted">@item.CreatedAtUtc.ToString("dd MMM yyyy HH:mm") UTC</div></td><td>@item.Email</td><td>@(item.SentAtUtc!=null?"Sent":item.DeliveryAttempts>=5?"Needs attention":"Queued")<div class="small text-muted">@item.DeliveryAttempts attempts</div>@if(item.LastDeliveryError!=null){<div class="small text-danger">@item.LastDeliveryError</div>}</td><td>@if(item.SentAtUtc==null && item.DeliveryAttempts>=5){<form asp-action="RetryEmail" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-soft btn-sm">Retry delivery</button></form>}</td></tr>}</tbody></table></div><p class="small text-muted mt-3">Configure SMTP through environment variables or user secrets. Cloud audit retries are available on the field updates page.</p>

@model List<GiftOfTheGivers.Helpers.Models.Donation>
@{
    ViewData["Title"] = "Donations";
    ViewData["NavActive"] = "donations";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div>
        <h1 class="h4 mb-1">Donations</h1>
        <p class="text-muted small mb-0">
            @ViewBag.DonationCount donations received · <strong>R @ViewBag.TotalZar.ToString("N2")</strong> in ZAR
        </p>
    </div>
</div>

<div class="card feature-card">
    @if (!Model.Any())
    {
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-inbox display-6 d-block mb-3" style="color: var(--ink-400);"></i>
            No donations yet. Donations come in through the public
            <a asp-area="" asp-controller="Donations" asp-action="Create">Donate page</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Donor</th>
                        <th>Amount</th>
                        <th>Type</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="fw-semibold small" style="font-family: var(--font-display);">@d.ReferenceNumber</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar" style="background: linear-gradient(135deg, var(--accent-500), var(--accent-400)); color: #1f2937;">@(d.DonorName.FirstOrDefault().ToString().ToUpperInvariant())</span>
                                    <div>
                                        <div class="fw-semibold small">@d.DonorName</div>
                                        <div class="small text-muted">@d.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-bold">@d.Amount.ToString("N2") @d.Currency</td>
                            <td>
                                @if (d.IsRecurring)
                                {
                                    <span class="badge badge-amber"><i class="bi bi-arrow-repeat me-1"></i>Monthly</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft"><i class="bi bi-gift me-1"></i>One-time</span>
                                }
                            </td>
                            <td class="small text-muted">@d.DonationDate.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

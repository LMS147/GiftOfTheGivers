@model GiftOfTheGivers.Helpers.Models.ViewModels.PagedResult<GiftOfTheGivers.Helpers.Models.Donation>
@{ViewData["Title"]="Donation records";ViewData["NavActive"]="donations";}
<div class="section-toolbar"><div><span class="eyebrow">Contribution management</span><h2 class="h3">Donation records</h2><p class="text-muted">Search and review demo submissions. No real payments are collected.</p></div><span class="badge badge-soft">@Model.TotalCount matching records</span></div><partial name="_Flash" />
<form class="filter-bar mb-4" method="get" role="search"><div class="flex-grow-1"><label class="form-label" for="q">Search</label><input id="q" name="q" value="@Context.Request.Query["q"]" class="form-control" placeholder="Donor, email or reference" /></div><div><label for="currency" class="form-label">Currency</label><select id="currency" name="currency" class="form-select"><option value="">All currencies</option>@foreach(var currency in new[]{"ZAR","USD","EUR"}){<option selected="@(Context.Request.Query["currency"]==currency)">@currency</option>}</select></div><div><label for="from" class="form-label">From</label><input id="from" name="from" type="date" value="@Context.Request.Query["from"]" class="form-control" /></div><div><label for="to" class="form-label">To</label><input id="to" name="to" type="date" value="@Context.Request.Query["to"]" class="form-control" /></div><button class="btn btn-gotg">Apply</button><a asp-action="Donations" class="btn btn-soft">Reset</a></form>
@if(Model.Items.Count==0){<div class="empty-state"><i class="bi bi-search" aria-hidden="true"></i><h3 class="h5">No matching records</h3><p>Try another search term, currency, or date range.</p></div>}
else{<div class="card table-responsive"><table class="table align-middle mb-0"><caption class="visually-hidden">Demo donation records</caption><thead><tr><th scope="col">Reference / Project</th><th scope="col">Donor</th><th scope="col">Amount</th><th scope="col">Date</th><th scope="col">Actions</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><strong>@item.ReferenceNumber</strong><div class="small text-muted">@(item.ReliefProject?.Name??"General relief fund")</div></td><td><strong>@item.DonorName</strong><div class="small text-muted">@item.Email</div></td><td class="text-nowrap">@item.Currency @item.Amount.ToString("N2")</td><td class="text-nowrap">@item.DonationDate.ToString("dd MMM yyyy")</td><td class="text-nowrap"><a asp-area="" asp-controller="Donations" asp-action="Details" asp-route-id="@item.Id" class="btn btn-soft btn-sm">Details</a> <a asp-area="" asp-controller="Donations" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Delete</a></td></tr>}</tbody></table></div>}
<partial name="_Pagination" model="Model" />

@model GiftOfTheGivers.Helpers.Models.ViewModels.PagedResult<GiftOfTheGivers.Helpers.Models.Volunteer>
@{ViewData["Title"]="Volunteer applications";ViewData["NavActive"]="volunteers";}
<div class="section-toolbar"><div><span class="eyebrow">People powering relief</span><h2 class="h3">Volunteer applications</h2><p class="text-muted">Review skills and availability, then share a decision.</p></div><span class="badge badge-soft">@Model.TotalCount matching applications</span></div><partial name="_Flash" />
<form class="filter-bar mb-4" method="get" role="search"><div class="flex-grow-1"><label for="q" class="form-label">Search volunteers</label><input id="q" name="q" value="@Context.Request.Query["q"]" class="form-control" placeholder="Name, email or skill" /></div><div><label for="status" class="form-label">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option>@foreach(var status in new[]{"Pending","Approved","Declined"}){<option selected="@(Context.Request.Query["status"]==status)">@status</option>}</select></div><button class="btn btn-gotg">Apply</button><a asp-action="Volunteers" class="btn btn-soft">Reset</a></form>
@if(Model.Items.Count==0){<div class="empty-state"><i class="bi bi-people" aria-hidden="true"></i><h3 class="h5">No matching applications</h3><p>Clear the filters or check back after volunteers apply.</p></div>}
else{<div class="card table-responsive"><table class="table align-middle mb-0"><caption class="visually-hidden">Volunteer applications and review actions</caption><thead><tr><th>Volunteer</th><th>Skills / Availability</th><th>Submitted</th><th>Status</th><th>Decision</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><strong>@item.FullName</strong><div class="small text-muted">@item.Email<br />@item.Phone</div>@if(!string.IsNullOrEmpty(item.Notes)){<details class="small"><summary>Application note</summary><p>@item.Notes</p></details>}</td><td><div class="small">@(item.Skills??"Not specified")</div><span class="badge badge-soft mt-1">@item.Availability</span></td><td class="text-nowrap">@item.SignUpDate.ToString("dd MMM yyyy")</td><td><span class="badge @(item.Status=="Pending"?"badge-amber":item.Status=="Declined"?"text-bg-danger":"badge-soft")">@item.Status</span></td><td><div class="d-flex flex-wrap gap-2">@foreach(var outcome in new[]{"Approved","Declined"}){if(item.Status!=outcome){<form asp-action="UpdateStatus" method="post" data-confirm="Change this application to @outcome? The volunteer will be notified."><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="status" value="@outcome" /><button class="btn @(outcome=="Approved"?"btn-gotg":"btn-outline-danger") btn-sm">@(outcome=="Approved"?"Approve":"Decline")</button></form>}}</div></td></tr>}</tbody></table></div>}
<partial name="_Pagination" model="Model" />

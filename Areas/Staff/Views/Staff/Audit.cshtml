@model GiftOfTheGivers.Helpers.Models.ViewModels.PagedResult<GiftOfTheGivers.Helpers.Models.StaffAuditEntry>
@{ViewData["Title"]="Staff audit history";ViewData["NavActive"]="audit";}
<span class="eyebrow">Accountability</span><h2 class="h3 mt-2">Who changed what</h2><p class="text-muted">A read-only record of staff decisions and project changes. Times are UTC.</p>
<form method="get" class="filter-bar mb-4" role="search"><div class="flex-grow-1"><label for="q" class="form-label">Search history</label><input id="q" name="q" class="form-control" value="@Context.Request.Query["q"]" placeholder="Staff member, action or description" /></div><button class="btn btn-gotg">Search</button><a asp-action="Audit" class="btn btn-soft">Reset</a></form>
@if(Model.Items.Count==0){<div class="empty-state"><h3 class="h5">No audit entries found</h3><p>New staff actions will appear here.</p></div>}
else{<div class="card table-responsive"><table class="table align-middle mb-0"><thead><tr><th>When (UTC)</th><th>Staff member</th><th>Action</th><th>Record</th><th>Description</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td class="text-nowrap">@item.OccurredAtUtc.ToString("dd MMM yyyy HH:mm")</td><td>@item.ActorName</td><td><span class="badge badge-soft">@item.Action</span></td><td>@item.EntityType #@item.EntityId</td><td>@item.Summary</td></tr>}</tbody></table></div>}
<partial name="_Pagination" model="Model" />

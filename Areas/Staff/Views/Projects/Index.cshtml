@model GiftOfTheGivers.Helpers.Models.ViewModels.PagedResult<GiftOfTheGivers.Helpers.Models.ReliefProject>
@{ViewData["Title"]="Manage projects";ViewData["NavActive"]="projects";}
<div class="section-toolbar"><div><span class="eyebrow">Relief operations</span><h2 class="h3">Project management</h2><p class="text-muted">Create projects, share their goals, and close completed work.</p></div><a asp-action="Create" class="btn btn-gotg"><i class="bi bi-plus-lg me-2"></i>New project</a></div>
<partial name="_Flash" />
<form class="filter-bar mb-4" method="get"><div class="flex-grow-1"><label class="form-label" for="q">Search projects</label><input id="q" name="q" value="@Context.Request.Query["q"]" class="form-control" /></div><div><label class="form-label" for="status">Status</label><select id="status" name="status" class="form-select"><option value="">All statuses</option><option value="active" selected="@(Context.Request.Query["status"]=="active")">Active</option><option value="closed" selected="@(Context.Request.Query["status"]=="closed")">Closed</option></select></div><button class="btn btn-gotg">Apply</button><a asp-action="Index" class="btn btn-soft">Reset</a></form>
@if(Model.Items.Count==0){<div class="empty-state"><h3 class="h5">No projects to show</h3><p>Create your first project or clear the filters.</p></div>}
else{<div class="card table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Project</th><th>Category</th><th>Demo target</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><strong>@item.Name</strong><div class="small text-muted">@item.Location</div></td><td>@item.Category</td><td>ZAR @item.TargetAmount.ToString("N2")</td><td><span class="badge @(item.IsActive?"badge-soft":"badge-amber")">@(item.IsActive?"Active":"Closed")</span></td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-soft btn-sm">Edit</a></td></tr>}</tbody></table></div>}
<partial name="_Pagination" model="Model" />

@model GiftOfTheGivers.Helpers.Models.ReliefProject
@{ViewData["Title"]=Model.Id==0?"New project":"Edit project";ViewData["NavActive"]="projects";}
<div class="form-shell"><a asp-action="Index" class="back-link">Back to projects</a><h2 class="h3 mt-3">@ViewData["Title"]</h2><p class="text-muted">Changes appear on the public project pages.</p><form asp-action="Save" method="post" class="card p-4 needs-validation" novalidate>
<input type="hidden" name="id" value="@Model.Id" /><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div><div class="col-md-6"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select">@foreach(var category in new[]{"Food","Water","Medical","Shelter","Education","Other"}){<option>@category</option>}</select></div></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="TargetAmount" class="form-label"></label><input asp-for="TargetAmount" type="number" min="0" step="0.01" class="form-control" /><span asp-validation-for="TargetAmount" class="text-danger"></span><div class="form-text">Use zero to hide the progress target. Demo totals include ZAR records only.</div></div>
<div class="mb-3"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" placeholder="https://…" /><span asp-validation-for="ImageUrl" class="text-danger"></span><div class="form-text">Leave blank to use a built-in illustration. Use images you have permission to publish.</div></div>
<div class="form-check mb-4"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Accept demo contributions</label><p class="small text-muted">Uncheck to close the project while preserving its history.</p></div>
<div class="d-flex gap-2"><button class="btn btn-gotg">Save project</button><a asp-action="Index" class="btn btn-soft">Cancel</a></div></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial" />}

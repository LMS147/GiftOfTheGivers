@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="state-page">
    <div class="state-icon"><i class="bi bi-shield-lock"></i></div>
    <h1>Access denied</h1>
    <p class="mb-4">
        You don't have permission to view this page. The staff dashboard is
        reserved for users with the <strong>Employee</strong> role.
    </p>
    <a class="btn btn-gotg px-4" asp-area="" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house me-1"></i> Back to home
    </a>
    <a class="btn btn-outline-secondary px-4" asp-area="" asp-controller="Donations" asp-action="Create">
        Make a donation
    </a>
</div>

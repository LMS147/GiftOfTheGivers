@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-brand">
            <img src="~/images/logo.svg" alt="Gift of the Givers logo" height="64" width="64" />
            <h1 class="h4 mt-3 mb-1">Welcome back</h1>
            <p class="text-muted small mb-0">Log in to manage your donations or the relief effort.</p>
        </div>

        <div class="auth-body">
            <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label"></label>
                    <div class="field-icon">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="you@example.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <div class="field-icon">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Your password" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label small"></label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-gotg btn-lg">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Log in
                </button>
            </form>

            <p class="text-center small mt-3 mb-0">
                New here?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
            </p>

            <div class="demo-box mt-4">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Demo accounts:</strong><br />
                Staff — <code>staff@gotg.org</code> / <code>Password123!</code><br />
                Volunteer — <code>volunteer@gotg.org</code> / <code>Password123!</code><br />
                Donor — <code>donor@gotg.org</code> / <code>Password123!</code>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
